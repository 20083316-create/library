@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
    var outCount = Model.Count(l => l.Status == "Out");
    var overdueCount = Model.Count(l => l.Status == "Overdue");
    var returnedCount = Model.Count(l => l.Status == "Returned");
}

<div class="page-head">
    <div>
        <h1>Loans</h1>
        <p class="page-sub">@Model.Count loans, newest first</p>
    </div>
    <a asp-action="Borrow" class="btn btn-primary">Borrow a book</a>
</div>

<div class="loan-summary">
    <div class="tile tile-out"><span class="tile-num">@outCount</span><span class="tile-label">Out</span></div>
    <div class="tile tile-overdue"><span class="tile-num">@overdueCount</span><span class="tile-label">Overdue</span></div>
    <div class="tile tile-returned"><span class="tile-num">@returnedCount</span><span class="tile-label">Returned</span></div>
</div>

<div class="loan-grid">
    @foreach (var loan in Model)
    {
        <div class="loan-card @("loan-" + loan.Status.ToLower())">
            <div class="loan-top">
                <span class="loan-status">@loan.Status</span>
                <span class="loan-due">Due @(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</span>
            </div>
            <h2 class="loan-book">@loan.BookTitle</h2>
            <p class="loan-member">@loan.MemberName</p>
            <p class="loan-dates">Loaned @(loan.LoanedOn.ToString("yyyy-MM-dd"))</p>
            @if (loan.ReturnedOn == null)
            {
                <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                    <button type="submit" class="btn btn-sm btn-return">Return</button>
                </form>
            }
        </div>
    }
</div>