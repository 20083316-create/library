@model MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="member-card">
    <h1>@Model.Member.FullName</h1>
    <p class="member-meta">@Model.Member.MemberType · @(Model.Member.Email ?? "no email")</p>
</div>

<h2 class="h5 mb-3">Loans</h2>
@if (Model.Loans.Count == 0)
{
    <div class="notice notice-info">This member has never borrowed a book.</div>
}
else
{
    <table class="table table-hover align-middle bg-white">
        <thead class="table-dark">
            <tr>
                <th>Book</th>
                <th>Loaned</th>
                <th>Returned</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model.Loans)
            {
                <tr>
                    <td>@loan.BookTitle</td>
                    <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                    <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "---")</td>
                    <td><span class="status-pill @("pill-" + loan.Status.ToLower())">@loan.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}
<a asp-action="Index" class="btn btn-link px-0">Back to members</a>