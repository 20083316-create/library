@{
    ViewData["Title"] = "Home";
}

<div class="lib-hero text-center">
    <h1 class="display-5">The Reading Room</h1>
    <p class="lead mb-4">Members, books and loans in one place, built for the staff who run the library.</p>
    <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg">Browse the books</a>
    <a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary btn-lg">See the members</a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card card-body h-100">
            <h2 class="h4">Books</h2>
            <p class="mb-0">Add new titles, correct a price or category, and remove books the library no longer holds.</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-body h-100">
            <h2 class="h4">Members</h2>
            <p class="mb-0">Register new readers, update their details, and keep the member list tidy.</p>
        </div>
    </div>
</div>